<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <!-- Colorful Mosque or Transparent Layer -->
    <ImageView
        android:id="@+id/compact_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_widget_mosque_night" />

    <!-- Foreground 2x2 Next Prayer Hero Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Lokasi + Refresh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/compact_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Jakarta"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/compact_refresh_btn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_widget_refresh"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_refresh_white" />
        </LinearLayout>

        <!-- Center Focus: Shalat Berikutnya -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/compact_next_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Berikutnya"
                android:textColor="#FFE2E8F0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/compact_next_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Dzuhur"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compact_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="11:45"
                android:textColor="#FFFDE047"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Pill: Active Prayer / Imsak -->
        <LinearLayout
            android:id="@+id/compact_footer_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_slot_glass_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/compact_footer_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Imsak 04:01 • Subuh 04:11"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
