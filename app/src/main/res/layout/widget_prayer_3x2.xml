<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget3x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget3x2_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_widget_mosque_night" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/widget3x2_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Jakarta"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/widget3x2_theme_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="2dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_widget_theme"
                android:padding="3dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_palette_white" />

            <ImageButton
                android:id="@+id/widget3x2_refresh_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_widget_refresh"
                android:padding="3dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_refresh_white" />
        </LinearLayout>

        <!-- Split Body: Left Hero + Right 6-Prayer Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Left Pane: Shalat Berikutnya -->
            <LinearLayout
                android:id="@+id/widget3x2_hero_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="0.44"
                android:background="@drawable/widget_slot_glass_dark"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/widget3x2_next_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berikutnya"
                    android:textColor="#FFE2E8F0"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget3x2_next_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Dzuhur"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget3x2_next_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="11:45"
                    android:textColor="#FFFDE047"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget3x2_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Kemenag RI"
                    android:textColor="#FFE2E8F0"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Right Pane: 2x3 Prayer Grid -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.56"
                android:orientation="vertical">

                <!-- Row 1: Imsak & Subuh -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:paddingBottom="3dp">

                    <LinearLayout
                        android:id="@+id/widget3x2_slot_imsak"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_slot_glass_dark"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="3dp">

                        <TextView
                            android:id="@+id/widget3x2_label_imsak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Imsak"
                            android:textColor="#FFFDE047"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget3x2_time_imsak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="04:01"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/widget3x2_slot_subuh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/widget_slot_glass_dark"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="3dp">

                        <TextView
                            android:id="@+id/widget3x2_label_subuh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subuh"
                            android:textColor="#FFE2E8F0"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget3x2_time_subuh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="04:11"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Dzuhur & Ashar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:paddingBottom="3dp">

                    <LinearLayout
                        android:id="@+id/widget3x2_slot_dzuhur"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_slot_glass_dark"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="3dp">

                        <TextView
                            android:id="@+id/widget3x2_label_dzuhur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dzuhur"
                            android:textColor="#FFE2E8F0"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget3x2_time_dzuhur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="11:45"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/widget3x2_slot_ashar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/widget_slot_glass_dark"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="3dp">

                        <TextView
                            android:id="@+id/widget3x2_label_ashar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ashar"
                            android:textColor="#FFE2E8F0"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget3x2_time_ashar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="15:01"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3: Maghrib & Isya -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/widget3x2_slot_maghrib"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_slot_glass_dark"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="3dp">

                        <TextView
                            android:id="@+id/widget3x2_label_maghrib"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maghrib"
                            android:textColor="#FFE2E8F0"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget3x2_time_maghrib"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="17:52"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/widget3x2_slot_isya"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/widget_slot_glass_dark"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="3dp">

                        <TextView
                            android:id="@+id/widget3x2_label_isya"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Isya"
                            android:textColor="#FFE2E8F0"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget3x2_time_isya"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="19:03"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
